{
  "name": "jobpilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "check:compose": "node scripts/check-compose-secrets.mjs --self-test",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "node scripts/gate24-integration.mjs",
    "e2e": "pnpm --filter @jobpilot/web e2e",
    "db:migrate": "pnpm --filter @jobpilot/db db:migrate",
    "db:seed": "pnpm --filter @jobpilot/db db:seed",
    "db:generate": "node scripts/db-generate.mjs",
    "postinstall": "node scripts/db-generate.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.4",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2"
  }
}
