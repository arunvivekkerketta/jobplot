# Copy this file to `.env` at the repository root and fill it in.
#
# Secrets: every value below must be generated, never copied from an example. In
# production the app refuses to start if one of them is missing or is one of the
# repository's public placeholder values (packages/core/src/config.ts).
#
#   APP_ENCRYPTION_KEY  openssl rand -base64 32      (must decode to 32 bytes)
#   NEXTAUTH_SECRET     openssl rand -base64 32
#   ADMIN_PASSWORD      a password you choose (16+ characters in production)
#   POSTGRES_PASSWORD   openssl rand -base64 24      (used by docker-compose.yml)
#
# On Windows `openssl` may not exist; Node can do the same job:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# The daily submission cap is a calendar day in this zone, not the server's.
# Example: Asia/Kolkata
APP_TIMEZONE=UTC

DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
EMBEDDING_PROVIDER=local
APP_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SMTP_URL=
NOTIFY_WEBHOOK_URL=
# The web app consumes the Auto-Pilot run queue in-process, so a click finishes
# without a second process. Set to 0 to leave runs to the worker container only.
JOBPILOT_IN_PROCESS_WORKER=
